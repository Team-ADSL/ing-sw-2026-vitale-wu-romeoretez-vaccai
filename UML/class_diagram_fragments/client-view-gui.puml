    +onEnter(): GUIScreen
    +createLoginScreen(e: LoginNeededEvent, ac: AppCoordinator): GUIScreen
    +createHomeScreen(e: HomeUpdateEvent, ac: AppCoordinator): GUIScreen
    +createLobbyScreen(e: LobbyUpdateEvent, ac: AppCoordinator): GUIScreen
    +createTotemPickingScreen(e: TotemAvailableEvent, ac: AppCoordinator): GUIScreen
    +createGameScreen(e: GameUpdateEvent, ac: AppCoordinator): GUIScreen
    +createEndGameScreen(e: EndGameEvent, ac: AppCoordinator): GUIScreen
    +createDisconnectedScreen(e: DisconnectedEvent, ac: AppCoordinator): GUIScreen
    +getThis(): GUIScreen
    {static} #applyTheme(root: Parent): void
    {static} #applyTheme(root: Parent, withBackground: boolean): void
    {static} -installButtonHover(node: Parent): void
    {static} -wireButtonHover(b: Button): void
    {static} -applyChalkFonts(node: Parent): void
    {static} -setFont(node: Label): void
    {static} -setFont(node: Button): void
    {static} -setFont(node: TextField): void
    {static} -pinFontFamily(node: Node, family: String): void
    {static} -setFont(node: Pane): void
    {static} -fontFor(node: Node, size: double): Font
    {static} -extractFontSize(style: String, fallback: double): double
  }
  note right of GUIScreen
    applyTheme adds theme.css + background image,
    pins ChristmasChalk font on Labels/Buttons,
    Roboto for nodes with styleClass="tech-text".
  end note

