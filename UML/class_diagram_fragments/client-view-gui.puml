@startuml client-view-gui
title Client — GUI: JavaFX, screens, FloatingLog, Chip, ImageCatalog (org.adsl.client.view.gui)

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

package "client.view.gui" {

  class GUI {
    {static} -WINDOW_TITLE: String = "MESOS"
    {static} -WINDOW_W: double = 1280
    {static} -WINDOW_H: double = 800
    {static} -MIN_W: double = 800
    {static} -MIN_H: double = 540
    -coordinator: AppCoordinator
    -stage: Stage
    -currentScreen: GUIScreen
    -shuttingDown: AtomicBoolean
    -keyboardNavMode: boolean
    +setAppCoordinator(coordinator: AppCoordinator): void
    +start(): void
    +shutdown(): void
    -installFocusVisibleBehavior(scene: Scene): void
    +dispatch(event: ServerEvent): void
    +transitionTo(screen: GUIScreen): void
    -runOnEnterChain(screen: GUIScreen): void
    -swapRoot(screen: GUIScreen): void
  }
  note right of GUI
    Platform.startup wires JavaFX runtime
    without subclassing Application.
    Stage.setOnCloseRequest consumes ev
    (sidesteps macOS Glass/JNI crash) and
    delegates to shutdown() (idempotent).
    swapRoot mutates the Scene's root
    rather than replacing the Scene to
    preserve macOS fullscreen state.
  end note

