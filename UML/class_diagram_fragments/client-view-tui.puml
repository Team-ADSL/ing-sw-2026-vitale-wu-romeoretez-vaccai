@startuml client-view-tui
title Client — TUI: terminal, screens, log & card catalogs (org.adsl.client.view.tui)

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

package "client.view.tui" {

  class TUI {
    -terminal: TuiTerminal
    -currentScreen: TUIScreen
    -eventQueue: LinkedBlockingQueue<ServerEvent>
    -running: boolean <<volatile>>
    +start(): void
    +shutdown(): void
    -loop(): void
    +transitionTo(screen: TUIScreen): boolean
    -toInputEvent(key: Key): InputEvent
    +dispatch(event: ServerEvent): void
    +onServerDisconnected(): void
    -showFatal(label: String, e: Exception): void
  }

  class TuiGameLog <<singleton>> {
    {static} +INSTANCE: TuiGameLog
    -history: List<String>
    -TuiGameLog()
    +append(text: String): void {synchronized}
    +recent(n: int): List<String> {synchronized}
    +all(): List<String> {synchronized}
    +size(): int {synchronized}
    +clear(): void {synchronized}
  }

  class CardCatalog <<utility>> {
    -CardCatalog()
    {static} +typeFromId(id: String): CardType
    {static} +typeLabel(type: CardType): String
    {static} +isEvent(type: CardType): boolean
    {static} +isCharacter(type: CardType): boolean
    {static} +typeSymbol(type: CardType): String
    {static} +totemLabel(totem: Totem): String
  }

  class CardTokens <<utility>> {
    -CardTokens()
    {static} -EMOJI_MAP: Map<String, String>
    {static} -TYPE_ABBR: Map<String, String>
    {static} +toEmoji(s: String): String
    {static} +toEffectLabel(s: String): String
    {static} -applyFoodCost(s: String): String
  }
}

package "client.view.tui.render" {

  class AnsiCodes <<utility>> {
    {static} +ESC: String
    {static} +CSI: String
    {static} +RESET: String
    {static} +CLEAR_SCREEN: String
    {static} +HIDE_CURSOR: String
    {static} +SHOW_CURSOR: String
    {static} +ALT_SCREEN_ON: String
    {static} +ALT_SCREEN_OFF: String
    {static} +moveCursor(row: int, col: int): String
  }

  enum TuiColor {
    BLACK
    RED
    GREEN
    YELLOW
    BLUE
    MAGENTA
    CYAN
    WHITE
    DEFAULT
    DARK_GRAY
    ORANGE
    DARK_PURPLE
    +fg(): String
    +bg(): String
  }

  class Key {
    -type: Type
    -character: char
    +getType(): Type
    +getCharacter(): char
    {static} +character(c: char): Key
    {static} +enter(): Key
    {static} +arrowUp(): Key
    {static} +arrowDown(): Key
    {static} +arrowLeft(): Key
    {static} +arrowRight(): Key
    {static} +escape(): Key
    {static} +backspace(): Key
  }
  enum "Key.Type" as KeyType {
    CHARACTER
    ENTER
    ARROW_UP
    ARROW_DOWN
    ARROW_LEFT
    ARROW_RIGHT
    ESCAPE
    BACKSPACE
  }

  class TuiSize <<record>> {
    +columns: int
    +rows: int
    +getColumns(): int
    +getRows(): int
  }

  class TuiTerminal {
    -terminal: Terminal
    -writer: PrintWriter
    -bindingReader: BindingReader
    -keyMap: KeyMap<KeyOp>
    -buffer: StringBuilder
    -savedAttributes: Attributes
    -closed: boolean
    +TuiTerminal()
    {static} -buildKeyMap(t: Terminal): KeyMap<KeyOp>
    {static} -bindArrow(m: KeyMap, t: Terminal, op: KeyOp, cap: Capability, ansiTail: String): void
    +getTerminalSize(): TuiSize
    +clear(): void
    +newTextGraphics(): TuiTextGraphics
    +refresh(): void
    +pollInput(timeoutMillis: long): Key
    +pollInput(): Key
    +close(): void {synchronized}
  }
  enum "TuiTerminal.KeyOp" as KeyOp {
    UP
    DOWN
    LEFT
    RIGHT
    ENTER
    BACKSPACE
    CHAR
  }

  class TuiTextGraphics {
    -out: StringBuilder
    -fg: TuiColor
    -bg: TuiColor
    ~TuiTextGraphics(out: StringBuilder)
    +setForegroundColor(color: TuiColor): void
    +setBackgroundColor(color: TuiColor): void
    +putString(col: int, row: int, text: String): void
  }
}

package "client.view.tui.screens" {

  abstract class TUIScreen <<extends Screen<TUIScreen>, InputEventVisitor>> {
    #terminal: TuiTerminal
    #username: String
    #toRender: boolean
    #showLog: boolean
    {static} -LOG_PREVIEW_COUNT: int = 3
    {static} -LOG_PREVIEW_WIDTH: int = 52
    #TUIScreen(terminal: TuiTerminal, ac: AppCoordinator, username: String)
    #TUIScreen(terminal: TuiTerminal, ac: AppCoordinator)
    #TUIScreen(terminal: TuiTerminal)
    #TUIScreen()
    +createLoginScreen(e: LoginNeededEvent, ac: AppCoordinator): TUIScreen
    +createHomeScreen(e: HomeUpdateEvent, ac: AppCoordinator): TUIScreen
    +createLobbyScreen(e: LobbyUpdateEvent, ac: AppCoordinator): TUIScreen
    +createTotemPickingScreen(e: TotemAvailableEvent, ac: AppCoordinator): TUIScreen
    +createGameScreen(e: GameUpdateEvent, ac: AppCoordinator): TUIScreen
    +createEndGameScreen(e: EndGameEvent, ac: AppCoordinator): TUIScreen
    +createDisconnectedScreen(e: DisconnectedEvent, ac: AppCoordinator): TUIScreen
    +getThis(): TUIScreen
    +visit(e: ConfirmEvent): TUIScreen
    +visit(e: SelectEvent): TUIScreen
    +visit(e: NavigateLeftEvent): TUIScreen
    +visit(e: NavigateRightEvent): TUIScreen
    +visit(e: NavigateUpEvent): TUIScreen
    +visit(e: NavigateDownEvent): TUIScreen
    +visit(e: CharInputEvent): TUIScreen
    +visit(e: BackspaceEvent): TUIScreen
    +handleEvent(event: ServerEvent): TUIScreen
    -captureLogMessage(event: ServerEvent): void
    #toggleLog(): void
    #drawLogPreview(tg: TuiTextGraphics, sz: TuiSize): void
    #drawLogWindow(tg: TuiTextGraphics, sz: TuiSize): void
    +handleEvent(event: InputEvent): TUIScreen
    +isToRender(): boolean
    +setToRender(value: boolean): void
    +onEnter(): TUIScreen
    {abstract} +render(): void
  }

  class ConnectingScreen {
    +ConnectingScreen(terminal: TuiTerminal, coordinator: AppCoordinator)
    +render(): void
    +visit(e: CharInputEvent): TUIScreen
  }

  class DisconnectedScreen {
    {static} -FIELD_RECONNECT: int = 0
    {static} -FIELD_EXIT: int = 1
    {static} -FIELD_COUNT: int = 2
    -message: String
    -focus: int
    -localError: String
    +DisconnectedScreen(terminal, coordinator, message)
    +render(): void
    +visit(e: NavigateLeftEvent): TUIScreen
    +visit(e: NavigateRightEvent): TUIScreen
    +visit(e: NavigateUpEvent): TUIScreen
    +visit(e: NavigateDownEvent): TUIScreen
    +visit(e: ConfirmEvent): TUIScreen
  }

  class EndGameScreen {
    -results: List<MatchResult>
    -records: List<DBRecord>
    -message: String
    +EndGameScreen(terminal, coordinator, username, results, records, message)
    +render(): void
    -renderMatchBlock(tg, col: int, width: int): void
    -renderDbBlock(tg, col: int, width: int): void
    +visit(e: ConfirmEvent): TUIScreen
    +visit(e: CharInputEvent): TUIScreen
  }

  class ExitScreen <<terminal>> {
    {static} +INSTANCE: ExitScreen
    -ExitScreen()
    +render(): void
    +isExit(): boolean
  }

  class HomeScreen {
    {static} -CREATE_OPTIONS: int = 4
    -activeGames: List<Integer>
    -gamePlayers: Map<Integer, List<String>>
    -gameCapacity: Map<Integer, Integer>
    -cursor: int
    -scrollOffset: int
    +HomeScreen(terminal, coordinator, username, activeGames, gamePlayers, gameCapacity)
    +render(): void
    +visit(e: HomeUpdateEvent): TUIScreen
    +visit(e: NavigateUpEvent): TUIScreen
    +visit(e: NavigateDownEvent): TUIScreen
    +visit(e: NavigateLeftEvent): TUIScreen
    +visit(e: NavigateRightEvent): TUIScreen
    +visit(e: ConfirmEvent): TUIScreen
    +visit(e: CharInputEvent): TUIScreen
    -totalOptions(): int
    -isJoinOption(i: int): boolean
    -isGameFull(gameId: int): boolean
    -optionLabel(i: int): String
    -sectionHeader(label: String): String
  }

  class LobbyScreen {
    -gameId: int
    -players: List<String>
    -totalPlayers: int
    +LobbyScreen(terminal, coordinator, username, gameId, players, totalPlayers)
    +render(): void
    +visit(e: CharInputEvent): TUIScreen
    +visit(e: LobbyUpdateEvent): TUIScreen
  }

  class LoginScreen {
    {static} -MAX_USERNAME_LENGTH: int = 20
    {static} -FIELD_TEXT: int = 0
    {static} -FIELD_LOGIN: int = 1
    {static} -FIELD_EXIT: int = 2
    {static} -FIELD_COUNT: int = 3
    -initialError: String
    -typed: StringBuilder
    -focus: int
    -submitted: boolean
    -localValidation: String
    +LoginScreen(terminal, coordinator)
    +LoginScreen(terminal, coordinator, initialError)
    +render(): void
    +visit(e: LoginNeededEvent): TUIScreen
    +visit(e: ErrorEvent): TUIScreen
    +visit(e: NavigateUpEvent): TUIScreen
    +visit(e: NavigateDownEvent): TUIScreen
    +visit(e: NavigateLeftEvent): TUIScreen
    +visit(e: NavigateRightEvent): TUIScreen
    +visit(e: ConfirmEvent): TUIScreen
    +visit(e: CharInputEvent): TUIScreen
    +visit(e: BackspaceEvent): TUIScreen
    -trySubmit(): TUIScreen
  }

  class TotemPickingScreen {
    {static} -ALL_TOTEMS: Totem[]
    -availableTotems: List<Totem>
    -cursor: int
    -selectedTotem: Totem
    -pendingPick: boolean
    -hasPicked: boolean
    +TotemPickingScreen(terminal, ac, username, availableTotems)
    +render(): void
    +onEnter(): TUIScreen
    +visit(e: NavigateUpEvent): TUIScreen
    +visit(e: NavigateDownEvent): TUIScreen
    +visit(e: NavigateLeftEvent): TUIScreen
    +visit(e: NavigateRightEvent): TUIScreen
    +visit(e: SelectEvent): TUIScreen
    +visit(e: ConfirmEvent): TUIScreen
    +visit(event: TotemAvailableEvent): TUIScreen
    +visit(e: ErrorEvent): TUIScreen
    -moveCursor(dir: int): void
    -ensureCursorOnAvailable(dir: int): void
    -totemColor(t: Totem): TuiColor
  }

  class GameScreen {
    -game: GameDTO
    -myTotem: Totem
    -subState: SubState
    -preWaitState: SubState
    -selectionIndex: int
    -onTopRow: boolean
    -selectedMoves: Set<Move>
    -upperCount: int
    -lowerCount: int
    -viewOnTopRow: boolean
    -topRowOffset: int
    -lowRowOffset: int
    -showLegend: boolean
    -showDecks: boolean
    -deckPlayerIndex: int
    -deckOffset: int
    {static} -CARD_W: int = 15
    -overlayTitle: String <<volatile>>
    -overlayLog: String <<volatile>>
    +GameScreen(terminal, coordinator, username, initialGame: GameDTO)
    +onEnter(): TUIScreen
    +render(): void
    +visit(e: GameUpdateEvent): TUIScreen
    +visit(e: EndGameEvent): TUIScreen
    +visit(e: ErrorEvent): TUIScreen
    +visit(e: EventsTriggeredEvent): TUIScreen
    +visit(e: ConfirmEvent): TUIScreen
    +visit(e: SelectEvent): TUIScreen
    +visit(e: NavigateLeftEvent): TUIScreen
    +visit(e: NavigateRightEvent): TUIScreen
    +visit(e: NavigateUpEvent): TUIScreen
    +visit(e: NavigateDownEvent): TUIScreen
    +visit(e: CharInputEvent): TUIScreen
  }
  enum "GameScreen.SubState" as SubState {
    MY_TURN_TOTEM
    MY_TURN_CARDS
    NOT_MY_TURN
    WAITING_SERVER
  }
}

TUI -up-|> "client.view.GameUI"
TUIScreen -up-|> "client.view.Screen"
TUIScreen ..|> "client.view.tui.events.InputEventVisitor"

ConnectingScreen -up-|> TUIScreen
DisconnectedScreen -up-|> TUIScreen
EndGameScreen -up-|> TUIScreen
ExitScreen -up-|> TUIScreen
HomeScreen -up-|> TUIScreen
LobbyScreen -up-|> TUIScreen
LoginScreen -up-|> TUIScreen
TotemPickingScreen -up-|> TUIScreen
GameScreen -up-|> TUIScreen

TUI *-- "1" TuiTerminal
TUI *-- "1" TUIScreen : "currentScreen"
TUIScreen --> "0..1" TuiTerminal
TUIScreen ..> TuiGameLog : append/recent/all
TuiTerminal +-- KeyOp
Key +-- KeyType
GameScreen +-- SubState
TuiTerminal --> TuiTextGraphics
TuiTextGraphics ..> TuiColor
TuiTextGraphics ..> AnsiCodes
TuiTerminal ..> AnsiCodes
TuiTerminal ..> Key

GameScreen ..> CardCatalog
GameScreen ..> CardTokens
EndGameScreen ..> "shared.model.MatchResult"
EndGameScreen ..> "shared.model.DBRecord"
GameScreen ..> "shared.model.GameDTO"
GameScreen ..> "shared.utils.Move"

note bottom of TUIScreen
  handleEvent(ServerEvent) captures the
  message field into TuiGameLog before
  dispatching via the visitor.
  Concrete screens override only what they
  need; defaults return this (stay).
end note

note bottom of TUI
  Event queue (LinkedBlockingQueue) is the
  network/main-thread bridge. Main loop
  renders → drains server events → polls
  keys → dispatches.
end note

@enduml
