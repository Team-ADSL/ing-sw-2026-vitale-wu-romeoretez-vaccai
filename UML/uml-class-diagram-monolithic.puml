package "shared.enums" {

  enum CardType {
    INVENTOR
    ARTIST
    HUNTER
    SHAMAN
    GATHERER
    BUILDER
    BUILDINGS
    SHAMANIC_RITUAL
    SUSTENANCE
    CAVE_PAINTINGS
    HUNT
  }

  enum Icon {
    BOAT
    SPEARHEAD
    HOOK
    NECKLACE
    BOWL
    ROPE
    TOTEM
    FLUTE
    LEATHER
    BREAD
  }

  enum Phase {
    TOTEM_PICKING
    TOTEM_PLACEMENT
    ACTION_EXECUTION
    EXTRA_MOVE
    EVENTS_EXECUTION
    END_ROUND
    END_GAME
  }

  enum Row {
    UPPER
    LOWER
    OFFER
  }

  enum Totem {
    RED
    WHITE
    BLACK
    BLUE
    YELLOW
  }

  enum Trigger {
    SUSTENANCE
    HUNT
    CAVE_PAINTINGS
    SHAMANIC_RITUAL
    END_GAME
    END_ROUND
    END_TURN
    DRAWING
    CHECK_BUILDINGS
    EVENT_EXECUTION
  }
}

package "shared.exceptions" {

