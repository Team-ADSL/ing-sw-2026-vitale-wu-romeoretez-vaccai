MoveRequest -up-|> ClientRequest
ExitGameRequest -up-|> ClientRequest
ClientRequest ..> RequestVisitor
MoveRequest ..> Move
TotemPickingRequest ..> Totem

' --- shared.network.responses ---
ServerPing -up-|> ServerResponse
ServerDisconnected -up-|> ServerResponse
LoginNeeded -up-|> ServerResponse
HomeUpdate -up-|> ServerResponse
LobbyUpdate -up-|> ServerResponse
TotemAvailableUpdate -up-|> ServerResponse
GameUpdate -up-|> ServerResponse
GameEnded -up-|> ServerResponse
ErrorResponse -up-|> ServerResponse
EventsTriggered -up-|> ServerResponse
ServerResponse ..> ResponseVisitor
GameUpdate ..> GameDTO
TotemAvailableUpdate ..> Totem
GameEnded ..> DBRecord
GameEnded ..> MatchResult

' --- shared.network.remote ---
RemoteClientStub ..> ServerResponse
RemoteServerService ..> ClientRequest
JsonMessageHandler ..> ClientRequest
JsonMessageHandler ..> ServerResponse

' --- shared.model ---
GameDTO *-- "many" PlayerDTO
GameDTO *-- "1" BoardDTO
BoardDTO *-- "*" CardDTO
BoardDTO *-- "*" OfferTileDTO
BoardDTO *-- "1" OrderTileDTO
OrderTileDTO *-- "*" OrderCellDTO
PlayerDTO *-- "*" CardDTO
CardDTO ..> CardToken
Move ..> Row

' --- server.config ---
JsonBoardConfigLoader ..|> BoardConfigLoader
JsonBoardConfigLoader +-- CardParser
JsonBoardConfigLoader +-- BuildingParser
JsonBoardConfigLoader ..> Card
JsonBoardConfigLoader ..> Building
JsonBoardConfigLoader ..> OfferTrack
JsonBoardConfigLoader ..> OrderTile
JsonBoardConfigLoader ..> GameSettings

' --- server.persistence ---
SqlGameDAO ..|> GameDAO
NoGameDAO ..|> GameDAO
SerialGamePersistenceManager ..|> GamePersistenceManager
GamePersistenceManager -up-|> GameObserver
SqlGameDAO --> "1" ConnectionProvider
SqlGameDAO ..> DBRecord

' --- server.db ---
DatabaseConfig ..|> ConnectionProvider
DatabaseManager ..> DatabaseConfig

' --- server.model.board ---
Board *-- "2" CardRow
Board *-- "1" OfferTrack
Board *-- "1" OrderTile
Board *-- "1" Deck
Board o-- "*" Card
