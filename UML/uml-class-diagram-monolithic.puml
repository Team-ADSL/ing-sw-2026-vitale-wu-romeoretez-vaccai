package "shared.network.requests" {

  interface "RequestVisitor<T>" as RequestVisitor {
    +visit(req: ClientPing, ctx: T): void
    +visit(req: ClientConnection, ctx: T): void
    +visit(req: LoginRequest, ctx: T): void
    +visit(req: LogoutRequest, ctx: T): void
    +visit(req: ExitLobbyRequest, ctx: T): void
    +visit(req: CreateGameRequest, ctx: T): void
    +visit(req: EnterGameRequest, ctx: T): void
    +visit(req: StartGameRequest, ctx: T): void
    +visit(req: TotemPickingRequest, ctx: T): void
    +visit(req: MoveRequest, ctx: T): void
    +visit(req: ExitGameRequest, ctx: T): void
    +visit(req: ClientDisconnected, ctx: T): void
  }

  abstract class ClientRequest <<@JsonTypeInfo, Serializable>> {
    {abstract} +<T> accept(visitor: RequestVisitor<T>, context: T): void
  }

  class ClientConnection {
    +<T> accept(visitor: RequestVisitor<T>, ctx: T): void
  }

  class ClientDisconnected {
    +<T> accept(visitor: RequestVisitor<T>, ctx: T): void
  }

  class ClientPing {
    +<T> accept(visitor: RequestVisitor<T>, ctx: T): void
  }

  class LoginRequest {
    -username: String
    +LoginRequest(username: String)
    +getUsername(): String
    +<T> accept(visitor: RequestVisitor<T>, ctx: T): void
  }

  class LogoutRequest {
    +<T> accept(visitor: RequestVisitor<T>, ctx: T): void
  }

  class CreateGameRequest {
    -numPlayer: int
    +CreateGameRequest(numPlayer: int)
    +getNumPlayer(): int
    +<T> accept(visitor: RequestVisitor<T>, ctx: T): void
  }

  class EnterGameRequest {
    -gameId: int
    +EnterGameRequest(gameId: int)
    +getGameId(): int
    +<T> accept(visitor: RequestVisitor<T>, ctx: T): void
  }

  class ExitLobbyRequest {
    +<T> accept(visitor: RequestVisitor<T>, ctx: T): void
  }

  class StartGameRequest {
    +<T> accept(visitor: RequestVisitor<T>, ctx: T): void
  }

  class TotemPickingRequest {
    -totem: Totem
    +TotemPickingRequest(totem: Totem)
    +getTotem(): Totem
    +<T> accept(visitor: RequestVisitor<T>, ctx: T): void
  }

  class MoveRequest {
    -moves: Set<Move>
    +MoveRequest(moves: Set<Move>)
    +getMoves(): Set<Move>
    +<T> accept(visitor: RequestVisitor<T>, ctx: T): void
  }

  class ExitGameRequest {
    +<T> accept(visitor: RequestVisitor<T>, ctx: T): void
  }
}

package "shared.network.responses" {

  interface ResponseVisitor {
    +visit(response: ServerPing): void
    +visit(response: LoginNeeded): void
    +visit(response: HomeUpdate): void
    +visit(response: LobbyUpdate): void
    +visit(response: TotemAvailableUpdate): void
    +visit(response: GameUpdate): void
    +visit(response: GameEnded): void
    +visit(response: ErrorResponse): void
    +visit(response: ServerDisconnected): void
    +visit(response: EventsTriggered): void
  }

  abstract class ServerResponse <<@JsonTypeInfo, Serializable>> {
    -message: String
    #ServerResponse()
    #ServerResponse(message: String)
    +getMessage(): String
    +setMessage(message: String): void
    +isHeartbeat(): boolean
    {abstract} +accept(visitor: ResponseVisitor): void
  }

  class ServerPing {
    +accept(visitor: ResponseVisitor): void
    +isHeartbeat(): boolean
  }

  class ServerDisconnected {
    +accept(visitor: ResponseVisitor): void
  }

  class LoginNeeded {
    +accept(visitor: ResponseVisitor): void
  }

  class HomeUpdate {
    -activeGames: List<Integer>
    -gamePlayers: Map<Integer, List<String>>
    -gameCapacity: Map<Integer, Integer>
    +HomeUpdate(activeGames: List<Integer>, gamePlayers: Map, gameCapacity: Map)
    +HomeUpdate(activeGames: List<Integer>)
    +getActiveGames(): List<Integer>
    +getGamePlayers(): Map<Integer, List<String>>
    +getGameCapacity(): Map<Integer, Integer>
    +accept(visitor: ResponseVisitor): void
  }

  class LobbyUpdate {
    -gameId: int
    -players: List<String>
    -numPlayerAllowed: int
    +LobbyUpdate(gameId: int, players: List<String>, numPlayerAllowed: int)
    +getGameId(): int
    +getPlayers(): List<String>
    +getNumPlayerAllowed(): int
    +accept(visitor: ResponseVisitor): void
  }

  class TotemAvailableUpdate {
    -totemAvailable: List<Totem>
    +TotemAvailableUpdate(totems: List<Totem>)
    +getTotemAvailable(): List<Totem>
    +accept(visitor: ResponseVisitor): void
  }

  class GameUpdate {
    -game: GameDTO
    +GameUpdate(game: GameDTO)
    +getGame(): GameDTO
    +accept(visitor: ResponseVisitor): void
  }

  class GameEnded {
    -records: List<DBRecord>
    -results: List<MatchResult>
    +GameEnded(records: List<DBRecord>, results: List<MatchResult>)
    +getRecords(): List<DBRecord>
    +getResults(): List<MatchResult>
    +accept(visitor: ResponseVisitor): void
  }

  class ErrorResponse {
    +ErrorResponse(message: String)
    +accept(visitor: ResponseVisitor): void
  }

  class EventsTriggered {
    -eventTitle: String
    -logMessage: String
    +EventsTriggered(eventTitle: String, logMessage: String)
    +getEventTitle(): String
    +getLogMessage(): String
    +accept(visitor: ResponseVisitor): void
  }
}

