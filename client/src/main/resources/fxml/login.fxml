<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           style="-fx-background-color: transparent;">
    <VBox alignment="CENTER" spacing="14" maxWidth="480" maxHeight="-Infinity" styleClass="panel"
          StackPane.alignment="CENTER">
        <padding><Insets top="32" right="40" bottom="32" left="40"/></padding>
        <ImageView fx:id="logoImage" fitWidth="380" preserveRatio="true"/>
        <Label text="Ancient Tribe Strategy" style="-fx-font-size: 15px; -fx-text-fill: #F2B035;"/>
        <Label fx:id="errorLabel" managed="false" visible="false"
               style="-fx-text-fill: #F2B035; -fx-font-size: 17px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.9), 5, 0.5, 0, 0);"
               wrapText="true"/>
        <Label text="Username" style="-fx-font-size: 14px; -fx-text-fill: #FDF3D3;"/>
        <TextField fx:id="usernameField" maxWidth="300" promptText="Enter username"/>
        <HBox alignment="CENTER" spacing="14">
            <Button fx:id="loginButton" text="Login" onAction="#onLogin" defaultButton="true"/>
            <Button fx:id="exitButton" text="Close" onAction="#onExit"/>
        </HBox>
    </VBox>
</StackPane>
