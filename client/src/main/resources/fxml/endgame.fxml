<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           style="-fx-background-color: transparent;">

    <!-- Fills full window; table expands to take all available vertical space -->
    <VBox alignment="CENTER" spacing="16" VBox.vgrow="ALWAYS">
        <padding><Insets top="40" right="48" bottom="32" left="48"/></padding>

        <Label text="M E S O S  —  Game Over"
               style="-fx-font-size: 30px; -fx-text-fill: #FDF3D3; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.9), 5, 0.5, 0, 0);"/>
        <Label text="Final Standings"
               style="-fx-font-size: 16px; -fx-text-fill: #F2B035; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.9), 5, 0.5, 0, 0);"/>

        <!-- Table grows to fill available space, respects window width -->
        <TableView fx:id="resultsTable" VBox.vgrow="ALWAYS"
                   maxWidth="Infinity" prefWidth="600">
            <columns>
                <TableColumn fx:id="rankCol"     text="Rank"            prefWidth="90"/>
                <TableColumn fx:id="nicknameCol" text="Player"          prefWidth="280"/>
                <TableColumn fx:id="scoreCol"    text="Prestige Points" prefWidth="170"/>
            </columns>
        </TableView>

        <HBox alignment="CENTER" spacing="14">
            <Button text="Back to Home"     onAction="#onBackHome"/>
            <Button text="Exit Application" onAction="#onExit"/>
        </HBox>
        <Label fx:id="errorLabel" style="-fx-text-fill: #F2B035; -fx-font-size: 17px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.9), 5, 0.5, 0, 0);" wrapText="true"/>
    </VBox>
</StackPane>
