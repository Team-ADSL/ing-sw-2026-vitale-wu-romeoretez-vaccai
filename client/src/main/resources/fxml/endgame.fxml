<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           style="-fx-background-color: transparent;">

    <VBox alignment="CENTER" spacing="16" VBox.vgrow="ALWAYS">
        <padding><Insets top="40" right="48" bottom="32" left="48"/></padding>

        <Label text="M E S O S  —  Game Over"
               style="-fx-font-size: 30px; -fx-text-fill: #FDF3D3; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.9), 5, 0.5, 0, 0);"/>
        <Label text="Final Standings"
               style="-fx-font-size: 16px; -fx-text-fill: #F2B035; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.9), 5, 0.5, 0, 0);"/>

        <SplitPane fx:id="splitPane" orientation="HORIZONTAL" dividerPositions="0.5"
                   VBox.vgrow="ALWAYS" maxWidth="Infinity">
            <items>
                <VBox alignment="TOP_CENTER" spacing="10">
                    <padding><Insets top="6" right="10" bottom="6" left="10"/></padding>
                    <Label text="This Match"
                           style="-fx-font-size: 16px; -fx-text-fill: #F2B035;"/>
                    <TableView fx:id="matchTable" VBox.vgrow="ALWAYS" maxWidth="Infinity">
                        <columns>
                            <TableColumn fx:id="matchRankCol"     text="#"      prefWidth="60"/>
                            <TableColumn fx:id="matchPlayerCol"   text="Player" prefWidth="220"/>
                            <TableColumn fx:id="matchPpCol"       text="PP"     prefWidth="90"/>
                            <TableColumn fx:id="matchFoodCol"     text="Food"   prefWidth="90"/>
                        </columns>
                    </TableView>
                </VBox>

                <StackPane fx:id="rightPane" alignment="CENTER">
                    <VBox fx:id="leaderboardBox" alignment="TOP_CENTER" spacing="10">
                        <padding><Insets top="6" right="10" bottom="6" left="10"/></padding>
                        <Label text="Overall Leaderboard"
                               style="-fx-font-size: 16px; -fx-text-fill: #F2B035;"/>
                        <TableView fx:id="recordsTable" VBox.vgrow="ALWAYS" maxWidth="Infinity">
                            <columns>
                                <TableColumn fx:id="dbRankCol"     text="Rank"   prefWidth="80"/>
                                <TableColumn fx:id="dbPlayerCol"   text="Player" prefWidth="220"/>
                                <TableColumn fx:id="dbScoreCol"    text="Score"  prefWidth="110"/>
                            </columns>
                        </TableView>
                    </VBox>
                    <Label fx:id="noDbAlert"
                           text="Game launched without database — overall leaderboard unavailable, this match will not be recorded."
                           wrapText="true" visible="false" managed="false"
                           style="-fx-text-fill: #E53935; -fx-font-size: 16px; -fx-font-weight: bold;
                                  -fx-padding: 24; -fx-border-color: #E53935; -fx-border-width: 2;
                                  -fx-border-radius: 12; -fx-background-color: rgba(40, 12, 6, 0.6);
                                  -fx-background-radius: 12;"/>
                </StackPane>
            </items>
        </SplitPane>

        <HBox alignment="CENTER" spacing="14">
            <Button text="Back to Home"     onAction="#onBackHome"/>
            <Button text="Exit Application" onAction="#onExit"/>
        </HBox>
        <Label fx:id="errorLabel" style="-fx-text-fill: #F2B035; -fx-font-size: 17px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.9), 5, 0.5, 0, 0);" wrapText="true"/>
    </VBox>
</StackPane>
