<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           style="-fx-background-color: #2c1a0e;">
    <VBox alignment="CENTER" spacing="16" maxWidth="640" styleClass="panel">
        <padding><Insets top="28" right="32" bottom="28" left="32"/></padding>
        <Label text="M E S O S  —  Game Over" style="-fx-font-size: 30px; -fx-text-fill: #f5deb3;"/>
        <Label text="Final Standings" style="-fx-font-size: 16px; -fx-text-fill: #b8946c;"/>
        <TableView fx:id="resultsTable" maxWidth="540">
            <columns>
                <TableColumn fx:id="rankCol"     text="Rank"            prefWidth="90"/>
                <TableColumn fx:id="nicknameCol" text="Player"          prefWidth="280"/>
                <TableColumn fx:id="scoreCol"    text="Prestige Points" prefWidth="170"/>
            </columns>
        </TableView>
        <HBox alignment="CENTER" spacing="14">
            <Button text="Back to Home"      onAction="#onBackHome"/>
            <Button text="Exit Application"  onAction="#onExit"/>
        </HBox>
        <Label fx:id="errorLabel" style="-fx-text-fill: #e53935; -fx-font-size: 13px;" wrapText="true"/>
    </VBox>
</StackPane>
