<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           style="-fx-background-color: transparent;">
    <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>
    <VBox alignment="CENTER" spacing="14" maxWidth="440" maxHeight="-Infinity" styleClass="panel">
        <padding><Insets top="28" right="36" bottom="28" left="36"/></padding>
        <Label text="Disconnected" style="-fx-font-size: 28px; -fx-text-fill: #D92938;"/>
        <Label fx:id="messageLabel" wrapText="true" style="-fx-font-size: 14px; -fx-text-fill: #FDF3D3;"/>
        <HBox alignment="CENTER" spacing="14">
            <Button text="Reconnect" onAction="#onReconnect"/>
            <Button text="Exit" onAction="#onExit"/>
        </HBox>
        <Label fx:id="errorLabel" style="-fx-text-fill: #F2B035; -fx-font-size: 17px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.9), 5, 0.5, 0, 0);" wrapText="true"/>
    </VBox>
</StackPane>
