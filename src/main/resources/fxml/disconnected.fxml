<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="14" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>
    <Label text="Disconnected" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #b00020;"/>
    <Label fx:id="messageLabel" wrapText="true"/>
    <HBox alignment="CENTER" spacing="14">
        <Button text="Reconnect" onAction="#onReconnect"/>
        <Button text="Exit" onAction="#onExit"/>
    </HBox>
    <Label fx:id="errorLabel" style="-fx-text-fill: #b00020;" wrapText="true"/>
</VBox>
