<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           style="-fx-background-color: #2c1a0e;">
    <VBox alignment="CENTER" spacing="14" maxWidth="440" maxHeight="-Infinity" styleClass="panel">
        <padding><Insets top="32" right="40" bottom="32" left="40"/></padding>
        <Label text="M E S O S" style="-fx-font-size: 40px; -fx-text-fill: #f5deb3;"/>
        <Label text="Ancient Tribe Strategy" style="-fx-font-size: 15px; -fx-text-fill: #b8946c;"/>
        <Label fx:id="errorLabel" style="-fx-text-fill: #e53935; -fx-font-size: 13px;" wrapText="true"/>
        <Label text="Username" style="-fx-font-size: 14px; -fx-text-fill: #c8b080;"/>
        <TextField fx:id="usernameField" maxWidth="300" promptText="Enter username"/>
        <HBox alignment="CENTER" spacing="14">
            <Button fx:id="loginButton" text="Login" onAction="#onLogin" defaultButton="true"/>
            <Button fx:id="exitButton" text="Close" onAction="#onExit"/>
        </HBox>
    </VBox>
</StackPane>
