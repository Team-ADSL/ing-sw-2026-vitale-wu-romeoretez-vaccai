<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="14" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <padding><Insets top="40" right="60" bottom="40" left="60"/></padding>
    <Label text="MESOS" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
    <Label text="Ancient Tribe Strategy"/>
    <Label fx:id="errorLabel" style="-fx-text-fill: #b00020;" wrapText="true"/>
    <Label text="Username:"/>
    <TextField fx:id="usernameField" maxWidth="260" promptText="Enter username"/>
    <HBox alignment="CENTER" spacing="14">
        <Button fx:id="loginButton" text="Login" onAction="#onLogin" defaultButton="true"/>
        <Button fx:id="exitButton" text="Close Application" onAction="#onExit"/>
    </HBox>
</VBox>
