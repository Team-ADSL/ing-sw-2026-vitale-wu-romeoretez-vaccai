<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="16" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      style="-fx-background-color: #2c1a0e;">
    <padding><Insets top="60" right="80" bottom="60" left="80"/></padding>
    <Label text="M E S O S" style="-fx-font-size: 36px; -fx-text-fill: #f5deb3;"/>
    <Label text="Ancient Tribe Strategy" style="-fx-font-size: 16px; -fx-text-fill: #b8946c;"/>
    <Label fx:id="errorLabel" style="-fx-text-fill: #e53935; -fx-font-size: 14px;" wrapText="true"/>
    <Label text="Username:" style="-fx-font-size: 15px;"/>
    <TextField fx:id="usernameField" maxWidth="280" promptText="Enter username"/>
    <HBox alignment="CENTER" spacing="16">
        <Button fx:id="loginButton" text="Login" onAction="#onLogin" defaultButton="true"/>
        <Button fx:id="exitButton" text="Close" onAction="#onExit"/>
    </HBox>
</VBox>
