<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="14" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
    <Label text="MESOS — Game Over" style="-fx-font-size: 26px; -fx-font-weight: bold;"/>
    <Label text="Final Standings" style="-fx-font-size: 16px;"/>
    <TableView fx:id="resultsTable" maxWidth="520">
        <columns>
            <TableColumn fx:id="rankCol" text="Rank" prefWidth="80"/>
            <TableColumn fx:id="nicknameCol" text="Player" prefWidth="280"/>
            <TableColumn fx:id="scoreCol" text="Prestige Points" prefWidth="160"/>
        </columns>
    </TableView>
    <HBox alignment="CENTER" spacing="14">
        <Button text="Back to Home" onAction="#onBackHome"/>
        <Button text="Exit Application" onAction="#onExit"/>
    </HBox>
    <Label fx:id="errorLabel" style="-fx-text-fill: #b00020;" wrapText="true"/>
</VBox>
