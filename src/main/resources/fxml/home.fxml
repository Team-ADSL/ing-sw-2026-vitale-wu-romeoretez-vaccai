<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    <Label fx:id="welcomeLabel" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <Label text="Create new game:"/>
    <HBox spacing="10">
        <Button text="2 Players" onAction="#onCreate2"/>
        <Button text="3 Players" onAction="#onCreate3"/>
        <Button text="4 Players" onAction="#onCreate4"/>
        <Button text="5 Players" onAction="#onCreate5"/>
    </HBox>
    <Label text="Join an active game:"/>
    <ListView fx:id="gamesList" maxHeight="220"/>
    <HBox spacing="10">
        <Button text="Join Selected" onAction="#onJoinSelected"/>
        <Button text="Logout" onAction="#onLogout"/>
    </HBox>
    <Label fx:id="errorLabel" style="-fx-text-fill: #b00020;" wrapText="true"/>
</VBox>
