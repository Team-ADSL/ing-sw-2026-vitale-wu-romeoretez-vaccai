<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    <Label fx:id="titleLabel" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <Label fx:id="statusLabel"/>
    <Label text="Players:"/>
    <ListView fx:id="playersList" maxHeight="240"/>
    <HBox spacing="10">
        <Button text="Start Game" onAction="#onStart"/>
        <Button text="Leave Lobby" onAction="#onLeave"/>
    </HBox>
    <Label fx:id="errorLabel" style="-fx-text-fill: #b00020;" wrapText="true"/>
</VBox>
