<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="10" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <VBox spacing="12" HBox.hgrow="ALWAYS">
        <Label fx:id="titleLabel" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        <Label fx:id="statusLabel"/>
        <Label text="Players:"/>
        <ListView fx:id="playersList" maxHeight="240"/>
        <HBox spacing="10">
            <Button text="Start Game" onAction="#onStart"/>
            <Button text="Leave Lobby" onAction="#onLeave"/>
        </HBox>
        <Label fx:id="errorLabel" style="-fx-text-fill: #b00020;" wrapText="true"/>
    </VBox>

    <VBox spacing="6" prefWidth="300" minWidth="240">
        <Label text="Lobby log" style="-fx-font-weight: bold;"/>
        <ScrollPane fx:id="chatScroll" fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background: #fafafa; -fx-border-color: #dddddd;">
            <VBox fx:id="chatBox" spacing="3">
                <padding><Insets top="6" right="6" bottom="6" left="6"/></padding>
            </VBox>
        </ScrollPane>
    </VBox>
</HBox>
