<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>

    <Label fx:id="headerLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <Label fx:id="phaseLabel"/>

    <Label text="TOP ROW" style="-fx-font-weight: bold;"/>
    <FlowPane fx:id="topRow" hgap="6" vgap="6"/>

    <Label text="OFFER TRACK" style="-fx-font-weight: bold;"/>
    <FlowPane fx:id="offerTrack" hgap="6" vgap="6"/>

    <Label text="BOTTOM ROW" style="-fx-font-weight: bold;"/>
    <FlowPane fx:id="bottomRow" hgap="6" vgap="6"/>

    <Label fx:id="tribeLabel" style="-fx-font-weight: bold;"/>
    <Label fx:id="tribeContents"/>

    <Label text="Other players:" style="-fx-font-weight: bold;"/>
    <VBox fx:id="othersBox" spacing="2"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Move (e.g. OFFER:0  or  UPPER:1,LOWER:2):"/>
        <TextField fx:id="moveInput" maxWidth="320" promptText="row:index,row:index..."/>
        <Button text="Send Move" onAction="#onSendMove"/>
    </HBox>

    <Label fx:id="errorLabel" style="-fx-text-fill: #b00020;" wrapText="true"/>
</VBox>
